{
  "manifest_version": 2,
  "name": "BR Helper | Скрипт для Форума",
  "version": "1.4.1",
  "description": "Black Russia Helper — расширение для Firefox для автоматизации работы на форуме forum.blackrussia.online",
  "applications": {
    "gecko": {
      "id": "br-helper@blackrussia.online",
      "strict_min_version": "58.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "https://forum.blackrussia.online/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://forum.blackrussia.online/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "icons": {
    "128": "icon128.png"
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  }
}
