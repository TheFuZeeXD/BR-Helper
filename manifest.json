{
  "manifest_version": 3,
  "name": "BR Helper | Скрипт для Форума",
  "version": "1.4.3",
  "description": "Black Russia Helper — это расширение для Google Chrome, разработанное для автоматизации ответов на темы форума forum.blackrussia.online.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://forum.blackrussia.online/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://forum.blackrussia.online/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "icons": {
    "128": "/image/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "128": "/image/icon128.png"
    }
  }
}