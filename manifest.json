{
  "manifest_version": 3,
  "name": "BR Helper | Скрипт для Форума",
  "version": "1.5.8",
  "description": "Black Russia Helper — это расширение специально разработанное для веб-браузера FireFox...",
  "browser_specific_settings": {
    "gecko": {
      "id": "br-helper@blackrussia.online",
      "strict_min_version": "58.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://forum.blackrussia.online/*"
  ],
  "content_scripts": [
    {
      "matches": [ "https://forum.blackrussia.online/*" ],
      "js": [ "theme.js" ],
      "css": [ "content.css" ],
      "run_at": "document_start"
    },
    {
      "matches": [ "https://forum.blackrussia.online/*" ],
      "js": [ "content.js", "widget.js" ],
      "css": [ "widget.css" ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "/image/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "128": "/image/icon128.png"
    }
  }
}
