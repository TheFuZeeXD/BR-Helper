{
  "manifest_version": 3,
  "name": "BR Helper | Скрипт для Форума",
  "version": "1.4.4",
  "description": "Black Russia Helper — это расширение для Google Chrome, разработанное для автоматизации ответов на темы форума forum.blackrussia.online.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://forum.blackrussia.online/*"
  ],

   "content_scripts": [
    {
      "matches": ["https://forum.blackrussia.online/*"],
      "js": ["theme.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://forum.blackrussia.online/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

    "web_accessible_resources": [{
    "resources": ["content.css"],
    "matches": ["<all_urls>"]
  }],
  "icons": {
    "128": "/image/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "128": "/image/icon128.png"
    }
  }
}